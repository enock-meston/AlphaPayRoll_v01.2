                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.IndemFct)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.Gratifications)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.Primes)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.AutresAvantage)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.SALAIRE_BRUT)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.SALAIRE_IMPOSABLE)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.TPR)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.Cotisation_Caisse_Social)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.RSSB_EMPLOYEE)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.MutSante)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.TotalReteNonStat)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.TotalRetenue)</td>
                            <td style="padding:4px; border:1px solid #ddd;">@FmtAmount0(item.NetAPayer)</td>
