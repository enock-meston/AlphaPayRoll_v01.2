                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.SALAIRE_BRUT) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.SALAIRE_IMPOSABLE) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.TPR) ?? 0)</td>
