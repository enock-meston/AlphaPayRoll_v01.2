@page "/AgentPDFReport/GetListPayGenPage"
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inherits GetListPayGenBase

@* ── Page Title ── *@
<h3 style="color:#004080; margin-bottom:20px; text-align:center;">Rapport des Salaires Agents Géneral</h3>


@* ── Toolbar ── *@
<div class="row mb-3">
    
    <div class="col-sm-2 m-2">
        <button type="button" class="btn btn-primary"
                @onclick="async () => await PrintComponent()"
                style="width:100%;">
            <i class="bi bi-printer me-1"></i> Imprimer
        </button>
    </div>
</div>


@* ── Screen Table (visible on screen, hidden on print) ── *@
<div class="table-responsive">
    <table class="table table-bordered table-striped table-sm">
        <thead class="table-dark">
            <tr>
                <th>No</th>
                <th>Matricule</th>
                <th>Nom Agent</th>
                <th>Mois</th>
                <th>Poste</th>
                <th>Salaire Base</th>
                <th>Indemnités</th>
                <th>Retenues</th>
                <th>Net à Payer</th>
                <th>Mois</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            @if (SalaireList != null)
            {
                int i = 1;
                foreach (var item in SalaireList)
                {
                    <tr>
                        <td>@i</td>
                        <td>@item.Matricule</td>
                        <td>@item.Noms</td>
                        <td>@item.Branch</td>
                        <td>@item.Code</td>
                        <td class="text-end">@item.SalBase.ToString("#,##0")</td>
                        <td class="text-end">@item.TotalIndem.ToString("#,##0")</td>
                        <td class="text-end text-danger">@item.TotalRetenue.ToString("#,##0")</td>
                        <td class="text-end fw-bold text-primary">@item.NetAPayer.ToString("#,##0")</td>
                        <td>@GetMoisFromBranch(item.Branch)</td>
                        <td>
                            <span class="badge bg-success">Calculé</span>
                        </td>
                    </tr>
                    i++;
                }
            }
        </tbody>
        <tfoot class="table-secondary fw-bold">
            <tr>
                <td colspan="5" class="text-end">TOTAL :</td>
                <td class="text-end">@SalaireList?.Sum(x => x.SalBase).ToString("#,##0")</td>
                <td class="text-end">@SalaireList?.Sum(x => x.TotalIndem).ToString("#,##0")</td>
                <td class="text-end text-danger">@SalaireList?.Sum(x => x.TotalRetenue).ToString("#,##0")</td>
                <td class="text-end text-primary">@SalaireList?.Sum(x => x.NetAPayer).ToString("#,##0")</td>
                <td colspan="2"></td>
            </tr>
        </tfoot>
    </table>
</div>


@* ════════════════════════════════════════════════
   PRINT AREA — hidden on screen, visible on print
   ════════════════════════════════════════════════ *@
<div id="printArea" style="display:none">
    <div class="liste-paie-print-root" style="font-family:Arial,sans-serif; padding:20px; max-width:100%; margin:auto; box-sizing:border-box;">

        @* ── Print Header ── *@
        <div style="border-bottom:2px solid #004080; padding-bottom:12px; margin-bottom:16px;">
            <div style="display:flex; align-items:center; gap:20px;">

                @* Logo *@
                <div style="flex:0 0 auto;">
                    @* <img src="@logoUrl" alt="Logo" *@
                    <img src="/Images/RIMICON.png" alt="Logo"
                         style="height:70px; width:auto; display:block;" />
                </div>

                @* Title + Date *@
                <div style="flex:1; text-align:center;">
                    <h3 style="color:#000000; margin:0 0 4px;">Rapport des Salaires Agents Géneral</h3>
                    <p style="margin:0; font-size:10px; color:#555;">
                        @* select Branch from  SalaireList  as Mois: *@
                        @* @(SalaireList != null && SalaireList.Count > 0 ? SalaireList[0].Branch : "") *@
                    </p>
                </div>

            </div>

        </div>

       

        @* ── Detail Table ── *@
