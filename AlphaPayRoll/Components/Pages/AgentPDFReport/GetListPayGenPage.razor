                <col style="width:5%;" />
                <col style="width:12%;" />
                <col style="width:6%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
