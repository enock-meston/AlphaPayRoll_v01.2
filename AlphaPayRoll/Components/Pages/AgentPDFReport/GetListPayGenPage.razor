                <col style="width:6%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:6%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
                <col style="width:5%;" />
            </colgroup>
           
            <thead>
