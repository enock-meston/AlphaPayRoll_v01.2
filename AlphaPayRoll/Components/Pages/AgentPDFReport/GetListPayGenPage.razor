                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.IndemLog) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.IndemDeplac) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.IndemFct) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.Gratifications) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.Primes) ?? 0)</td>
