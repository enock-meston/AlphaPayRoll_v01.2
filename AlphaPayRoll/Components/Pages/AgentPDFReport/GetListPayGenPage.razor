                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.RSSB_EMPLOYEE) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.MutSante) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.TotalReteNonStat) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.TotalRetenue) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.NetAPayer) ?? 0)</td>
                    <td style="padding:5px 6px; border:1px solid #ccc; text-align:right; color:#000000;">@FmtAmount0(SalaireList?.Sum(x => x.Cotisation_Patronale) ?? 0)</td>
