            <thead>
                <tr style="background-color:#b0c4de;">
                    <th style="padding:5px 6px; border:1px solid #999; text-align:left; font-weight:bold;">Intitulé</th>
                    <th style="padding:5px 6px; border:1px solid #999; text-align:right; font-weight:bold;">Rémunération</th>
                    <th style="padding:5px 6px; border:1px solid #999; text-align:right; font-weight:bold;">Retenue</th>
                    <th style="padding:5px 6px; border:1px solid #999; text-align:right; font-weight:bold;">Total/Balance</th>
                </tr>
            </thead>
            <tbody>
                @if (SalaireList != null)
                {
                    @* --- Rémunérations --- *@
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">SalBase</td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.SalBase)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Indemnité de logement</td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.IndemLog)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Indemnité de transport</td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.IndemDeplac)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Indemnité de Fonction</td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.IndemFct)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>

                    @* --- Total Indemnités --- *@
                    <tr style="font-weight:bold;">
                        <td style="padding:4px 6px; border:1px solid #ccc;">Total Indemnites</td>
                        <td style="padding:4px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:4px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:4px 6px; border:1px solid #ccc; text-align:right;">@FmtAmount0(SalaireList.TotalIndem)</td>
                    </tr>

                    @* --- Gratification / Primes / Avantages --- *@
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd; font-size:10px;">Gratification</td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.Gratifications)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Prime</td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.Primes)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Autres avantages</td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.AutresAvantage)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>

                    @* --- Salaire Brut --- *@
                    <tr style="font-weight:bold;">
                        <td style="padding:4px 6px; border:1px solid #ccc;">Salaire brut</td>
                        <td style="padding:4px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:4px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:4px 6px; border:1px solid #ccc; text-align:right;">@FmtAmount0(SalaireList.SALAIRE_BRUT)</td>
                    </tr>

                    @* --- Salaire Imposable --- *@
                    <tr style="font-weight:bold;">
                        <td style="padding:4px 6px; border:1px solid #ccc;">Salaire imposable</td>
                        <td style="padding:4px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:4px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:4px 6px; border:1px solid #ccc; text-align:right;">@FmtAmount0(SalaireList.SALAIRE_IMPOSABLE)</td>
                    </tr>

                    @* --- Retenues Statutaires --- *@
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Cotisation Caisse Sociale</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.Cotisation_Caisse_Social)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">RSSB Employé</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.RSSB_EMPLOYEE)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Mutuelle de santé</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.MutSante)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">TPR</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.TPR)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>

                    @* --- TOTAL DU --- *@
                    <tr style="font-weight:bold;">
                        <td style="padding:4px 6px; border:1px solid #ccc;">TOTAL DU:</td>
                        <td style="padding:4px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:4px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:4px 6px; border:1px solid #ccc; text-align:right;">@FmtAmount0(0)</td>
                    </tr>

                    @* --- Retenues Non Statutaires --- *@
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Ejo Heza</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.RetEjoHeza)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Remboursement crédit</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.RembCredit)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Autres retenues</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.AutRetenues)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Prime Life</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.Primes)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">RSSB Pension</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.RSSBPens)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Retenue Caisse Epargne</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.RetCaisEp)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Retenue Caisse Solidalite</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.RetCaisseSolid)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Retenue SanLam</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.RetSanLam)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>

                    @* --- Total Retenues --- *@
                    <tr style="font-weight:bold;">
                        <td style="padding:4px 6px; border:1px solid #ccc;">Total Retenues</td>
                        <td style="padding:4px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:4px 6px; border:1px solid #ccc; text-align:right;">@FmtAmount0(SalaireList.TotalRetenue)</td>
                        <td style="padding:4px 6px; border:1px solid #ccc;"></td>
                    </tr>

                    @* --- Net à Payer --- *@
                    <tr style="font-weight:bold; font-size:10px;">
                        <td style="padding:5px 6px; border:1px solid #ccc;">Net à payer</td>
                        <td style="padding:5px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:5px 6px; border:1px solid #ccc;"></td>
                        <td style="padding:5px 6px; border:1px solid #ccc; text-align:right;">@FmtAmount0(SalaireList.NetAPayer)</td>
                    </tr>

                    @* --- Cotisations Patronales --- *@
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">Cotisation patronale</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.Cotisation_Patronale)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #ddd;">RSSB Employeur</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                        <td style="padding:3px 6px; border:1px solid #ddd; text-align:right;">@FmtAmount0(SalaireList.RSSB_EMPLOYEUR)</td>
                        <td style="padding:3px 6px; border:1px solid #ddd;"></td>
                    </tr>
                }
            </tbody>
        </table>

        @* ── Signatures ── *@
        <div style="margin-top:30px;">
            <table style="width:100%; font-size:10px;">
                <tr>
                    <td style="width:40%; padding:8px; text-align:center;">
                        <span style="margin-right:10px;">Pour Signature</span>
                    </td>
                    <td style="width:30%; padding:8px; text-align:center;">
                        <div style="background-color:#87ceeb; border:1px solid #aaa; padding:6px 20px; display:inline-block; min-width:80px;">
                            Employé
                        </div>
                    </td>
                    <td style="width:30%; padding:8px; text-align:center;">
                        <div style="background-color:#87ceeb; border:1px solid #aaa; padding:6px 20px; display:inline-block; min-width:80px;">
                            Employeur
                        </div>
                    </td>
                </tr>
            </table>
        </div>

    </div>
</div>


@* ════════════════════════════════════════════════
   PRINT SCRIPT
   ════════════════════════════════════════════════ *@

<script type="text/javascript">
    function printComponent(selector) {
        var el = document.querySelector(selector);
        if (!el) { alert('Print area not found'); return; }

        var printWindow = window.open('', '_blank', 'width=900,height=700');
        printWindow.document.open();
        printWindow.document.write(`
            <html>
            <head>
                <title>Bulletin De Paie</title>
                <style>
                    * { box-sizing: border-box; }
                    body {
                        margin: 0;
                        padding: 0;
                        font-family: Arial, sans-serif;
                        font-size: 9px;
                        color: #000;
                    }
                    .bulletin-print-root {
                        width: 100%;
                        max-width: none;
                        padding: 15mm 12mm;
                    }
                    table {
                        width: 100%;
                        border-collapse: collapse;
                    }
                    th, td {
                        overflow: hidden;
                        word-wrap: break-word;
                        vertical-align: middle;
                    }

                    @@page {
                        size: A4 portrait;
                        margin: 0;
                    }

                    @@media print {
                        body { margin: 0; padding: 0; }
                        .bulletin-print-root { padding: 10mm 12mm !important; }
                        table { page-break-inside: auto; }
                        tr { page-break-inside: avoid; page-break-after: auto; }
                        thead { display: table-header-group; }
                        -webkit-print-color-adjust: exact;
                        print-color-adjust: exact;
                    }
                </style>
            </head>
            <body>
                ${el.innerHTML}
                <script>
                    window.onload = function () {
                        window.print();
                        window.close();
                    };
                <\/script>
            </body>
            </html>
        `);
        printWindow.document.close();
    }
</script>

