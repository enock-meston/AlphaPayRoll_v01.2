@page "/AgentPDFReport/BulletinReportPage"
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inherits BulletinReportBase

@* ── Page Title ── *@
<h3 style="color:#004080; margin-bottom:20px; text-align:center;">Bulletin De Paie du @SalaireList.date1.ToString("yyyy-MM-dd") </h3>



<div class="row mb-3">

    <!-- Exercice (Year) -->
    <div class="col-sm-2 m-2">
        <label>Exercice</label>
        <select class="form-control" @bind="Exercice">
            <option value="">-- Select Year --</option>
            @foreach (var year in Years)
            {
                <option value="@year">@year</option>
            }
        </select>
    </div>

    <!-- Mois (Month) -->
    <div class="col-sm-2 m-2">
        <label>Mois</label>
        <select class="form-control" @bind="Mois">
            <option value="">-- Select Month --</option>
            @foreach (var month in Months)
            {
                <option value="@month.Value">@month.Text</option>
            }
        </select>
    </div>

    <!-- Matricule -->
    <div class="col-sm-2 m-2">
        <label>Matricule</label>
        <input type="text" class="form-control" @bind="Matricule" placeholder="Enter Matricule" />
    </div>

    <!-- Print Button -->
    <div class="col-sm-2 m-2 d-flex align-items-end">
        <button type="button" class="btn btn-primary w-100"
                @onclick="async () => await SearchButton()">
            <i class="bi bi-printer me-1"></i> search
        </button>
    </div>
    <!-- Print Button -->
    <div class="col-sm-2 m-2 d-flex align-items-end">
        <button type="button" class="btn btn-primary w-100"
                @onclick="async () => await PrintComponent()">
            <i class="bi bi-printer me-1"></i> Imprimer
        </button>
    </div>

</div>

<hr />

<div class="table-responsive">
    <table class="table table-bordered table-striped table-sm">
        <thead class="table-dark">
            <tr>
                <th>No</th>
                <th>Matricule</th>
                <th>Nom Agent</th>
                <th>Poste</th>
                <th>Salaire Base</th>
                <th>Indemnités</th>
                <th>Retenues</th>
                <th>Net à Payer</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @if (SalaireList != null)
            {
                <tr>
                    <td>1</td>
                    <td>@SalaireList.Matricule</td>
                    <td>@SalaireList.Names</td>
                    <td>@SalaireList.Fonction</td>
                    <td class="text-end">@SalaireList.SalBase.ToString("#,##0")</td>
                    <td class="text-end">@SalaireList.TotalIndem.ToString("#,##0")</td>
                    <td class="text-end text-danger">@SalaireList.TotalRetenue.ToString("#,##0")</td>
                    <td class="text-end fw-bold text-primary">@SalaireList.NetAPayer.ToString("#,##0")</td>
                    <td class="text-end fw-bold text-primary">
                        <button type="button" class="btn btn-primary w-100"
                                @onclick="async () => await PrintComponent()">
                            <i class="bi bi-printer me-1"></i> Imprimer
                        </button>
                    </td>
                    
                </tr>
            }
        </tbody>

        <tfoot class="table-secondary fw-bold">
            @if (SalaireList != null)
            {
                <tr>
                    <td colspan="4" class="text-end">TOTAL :</td>
                    <td class="text-end">@SalaireList.SalBase.ToString("#,##0")</td>
                    <td class="text-end">@SalaireList.TotalIndem.ToString("#,##0")</td>
                    <td class="text-end">@SalaireList.TotalRetenue.ToString("#,##0")</td>
                    <td class="text-end">@SalaireList.NetAPayer.ToString("#,##0")</td>
                    <td colspan="1" class="text-end"> </td>
                    
                </tr>
            }
        </tfoot>
    </table>
</div>

@* ════════════════════════════════════════════════
   PRINT AREA — hidden on screen, visible on print
   ════════════════════════════════════════════════ *@
<div id="printArea" style="display:none">
    <div class="bulletin-print-root" style="font-family:Arial,sans-serif; padding:20px; max-width:700px; margin:auto; box-sizing:border-box;">

        @* ── Header ── *@
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;">
            @* Left: Logo / Company info *@
            <div style="flex:0 0 auto; font-size:9px; line-height:1.5;">
                <img src="/Images/RIMICON.png" alt="Logo"
                     style="height:40px; width:auto; display:block; margin-bottom:4px;" />
                <div style="font-weight:bold; font-size:9px;">RÉSEAU INTERDIOCÉSAIN</div>
                <div style="font-weight:bold; font-size:9px;">DE MICROFINANCE</div>
                <div style="font-size:8px;">+250788320675 / 2004951</div>
            </div>

            @* Center: Title *@
            <div style="flex:1; text-align:center; padding:0 10px;">
                <h2 style="margin:0; font-size:16px; font-weight:bold; color:#000;">
                    Bulletin De Paie du @SalaireList.date1.ToString("yyyy-MM-dd")
                </h2>
            </div>

            @* Right: Print date *@
            <div style="flex:0 0 auto; font-size:9px; text-align:right;">
                <span>Imprimé le &nbsp;</span>
                <span>@DateTime.Now.ToString("yyyy-MM-dd")</span>
            </div>
        </div>

        @* ── Employee Info ── *@
        @if (SalaireList != null)
        {
            <table style="width:100%; font-size:9px; margin-bottom:8px; border-collapse:collapse;">
                <tr>
                    <td style="width:15%; font-style:italic; padding:2px 4px;">Matric./Nom</td>
                    <td style="width:35%; padding:2px 4px; font-weight:bold;">@SalaireList.Matricule &nbsp; @SalaireList.Names</td>
                    <td style="width:15%;"></td>
                    <td style="width:35%;"></td>
                </tr>
                <tr>
                    <td style="font-style:italic; padding:2px 4px;">Guichet</td>
                    <td style="padding:2px 4px;">@SalaireList.SBranchID</td>
                    <td style="font-style:italic; padding:2px 4px;">Engagé le</td>
                    <td style="padding:2px 4px;">@SalaireList.DateRecrutment.ToString("yyyy-MM-dd")</td>
                </tr>
                <tr>
                    <td style="font-style:italic; padding:2px 4px;">Fonction</td>
                    <td style="padding:2px 4px;">@SalaireList.Fonction</td>
                    <td style="font-style:italic; padding:2px 4px;">Jours payé</td>
                    <td style="padding:2px 4px;">@SalaireList.PayDay </td>
                </tr>
            </table>
        }

        @* ── Main Pay Table ── *@
